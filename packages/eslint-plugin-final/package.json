        "eslint-plugin",
        "typescript",
        "final",
        "sealed"
    ],
    "peerDependencies": {
        "eslint": ">=9.0.0 <10",
        "typescript": ">=5.0.0 <6"
    },
    "devDependencies": {
        "typescript": "^5.0.0",
        "@types/eslint": "^9.0.0"
    }
